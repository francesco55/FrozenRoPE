#!/bin/bash -l
#$ -P cs599b1
#$ -N posext_yarn_grid
#$ -l h_rt=24:00:00
#$ -l gpus=1
#$ -l gpu_type=A100
#$ -l gpu_memory=40G
#$ -pe omp 8
#$ -j y
#$ -o logs/yarn_grid_$JOB_ID.log

set -euo pipefail

POSEXT_ROOT="${POSEXT_ROOT:-/projectnb/cs599b1/students/adithyad/FrozenRoPE}"
cd "$POSEXT_ROOT"
# shellcheck disable=SC1091
source "${POSEXT_ROOT}/scripts/scc/env.sh"
mkdir -p outputs/yarn_grid

if command -v uv >/dev/null 2>&1; then
  PY=(uv run python)
elif [[ -x "${UV_PROJECT_ENVIRONMENT}/bin/python" ]]; then
  PY=("${UV_PROJECT_ENVIRONMENT}/bin/python")
else
  echo "No uv and no venv at $UV_PROJECT_ENVIRONMENT — run scripts/scc/setup.sh first" >&2
  exit 1
fi

"${PY[@]}" -m posext.baselines.yarn_grid --device cuda --out-dir outputs/yarn_grid
